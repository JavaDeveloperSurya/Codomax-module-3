# --- Required for MongoDB Atlas / local MongoDB ---
# Example Atlas URI:
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/codomax?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/codomax

# --- Required: sign session JWTs (use a long random string) ---
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret

# --- Optional demo helpers (used by `npm run demo`) ---
# DEMO_MODE=true
# NEXT_PUBLIC_DEMO_MODE=true
# SEED_DEMO=true
